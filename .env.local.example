# Copy to .env.local and fill in. Never commit .env.local.

# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...). The legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The only Google account (email) allowed to sign in. Everyone is refused if this is unset.
ALLOWED_EMAIL=

# Optional: public URL Google sign-in returns to. Defaults to the request's host.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
