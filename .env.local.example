# Copy to .env.local and fill in. Never commit .env.local.

# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...). The legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The only email address allowed to sign in. Sign-in is refused if this is unset.
ALLOWED_EMAIL=

# Optional: public URL used in magic links. Defaults to the request's host.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
